{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jhacarreiro/elsewhere/schemas/decision-record.v0.schema.json",
  "title": "Decision record v0",
  "description": "One consequential decision in a development run, with its provenance. Proposal; see docs/DECISION_RECORD.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "run", "stage", "time", "decided_by", "question", "state", "chosen", "alternatives", "classification", "evidence", "producer"],
  "properties": {
    "schema_version": { "const": 0 },
    "id": {
      "type": "string",
      "pattern": "^dec_[0-9a-f]{16}$",
      "description": "Stable id: first 16 hex characters of sha256(run_id + newline + primary evidence pointer + newline + anchor)."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": { "type": "string" },
        "root_run_id": { "type": "string" },
        "generation": { "type": "integer", "minimum": 0 },
        "attempt_id": { "type": "string" },
        "round": { "type": "integer", "minimum": 0, "description": "Review or correction round, when the decision belongs to one." }
      }
    },
    "stage": {
      "enum": ["planning", "plan_review", "implementation", "review", "correction", "final_validation", "delivery", "follow_up", "recovery", "other"]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": ["string", "null"], "format": "date-time" },
        "source": { "enum": ["artifact_field", "artifact_header", "file_mtime", "commit_time", "unknown"] }
      }
    },
    "decided_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["human", "agent", "council", "control_plane", "adapter_rule", "unknown"] },
        "role": { "type": "string", "description": "Seat or role as recorded, for example reviewer, synthesizer, implementer." },
        "configured_model": { "type": "string" },
        "runtime_model": { "type": "string", "description": "Only when the run recorded it; never copied from configuration." }
      }
    },
    "question": { "type": "string", "minLength": 1, "maxLength": 500, "description": "What was decided, in one sentence." },
    "state": {
      "enum": ["decided", "pending", "not_completed", "superseded", "unknown"],
      "description": "pending: asked, no answer recorded. not_completed: attempted, no result. superseded: replaced by a later record."
    },
    "chosen": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["summary", "classification"],
      "description": "Required when state is decided or superseded; null otherwise.",
      "properties": {
        "option_id": { "type": "string" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "classification": { "$ref": "#/$defs/classification", "description": "Classification of the chosen option itself, for example observed for a recorded human answer." },
        "executed": { "enum": ["yes", "no", "unknown"] },
        "validated": { "enum": ["yes", "no", "unknown"] },
        "outcome": { "$ref": "#/$defs/claim" }
      }
    },
    "alternatives": {
      "type": "object",
      "description": "listed requires at least one item; none_considered and unknown require none.",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": {
          "enum": ["listed", "none_considered", "unknown"],
          "description": "none_considered only when the source says no alternative was considered; unknown otherwise."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "classification"],
            "properties": {
              "option_id": { "type": "string" },
              "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
              "advantages": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
              "limitations": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
              "classification": { "$ref": "#/$defs/classification" },
              "executed": { "const": "no", "description": "An alternative is a hypothesis until a later record shows it executed and validated." }
            }
          }
        }
      }
    },
    "generated_alternatives": { "$ref": "#/$defs/generated_alternatives" },
    "rationale": {
      "oneOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }],
      "description": "null when no rationale was recorded. Never reconstructed from hidden reasoning."
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "unknown"] },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inputs for the relevance filter. Each axis is unknown unless evidence supports a value.",
      "properties": {
        "impact": { "$ref": "#/$defs/level" },
        "reversibility": { "enum": ["easy", "costly", "irreversible", "unknown"] },
        "cost": { "$ref": "#/$defs/level" },
        "uncertainty": { "$ref": "#/$defs/level" }
      }
    },
    "classification": {
      "$ref": "#/$defs/classification",
      "description": "Classification of the record as a whole: the weakest classification among chosen, outcome and rationale."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "root", "pointer", "sha256"],
        "properties": {
          "artifact": { "type": "string", "description": "Logical artifact name, for example intervention, review_debate, failure_classification." },
          "pointer": { "type": "string", "description": "Path relative to the run or adapter root, plus #json-pointer or #Lstart-Lend." },
          "root": { "enum": ["run", "adapter", "repository"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash of the source file when read." },
          "excerpt": { "type": "string", "maxLength": 300, "description": "Short sanitized quote; optional." }
        }
      }
    },
    "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^dec_[0-9a-f]{16}$" } },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^dec_[0-9a-f]{16}$" } },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "mode": { "enum": ["emitted", "extracted"], "description": "emitted: written by the adapter at decision time. extracted: read from artifacts after the run." }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["decided", "superseded"] } } },
      "then": { "properties": { "chosen": { "type": "object" } } },
      "else": { "properties": { "chosen": { "type": "null" } } }
    },
    {
      "if": { "properties": { "alternatives": { "properties": { "status": { "const": "listed" } } } } },
      "then": { "properties": { "alternatives": { "properties": { "items": { "minItems": 1 } } } } },
      "else": { "properties": { "alternatives": { "properties": { "items": { "maxItems": 0 } } } } }
    },
    {
      "if": { "required": ["generated_alternatives"], "properties": { "generated_alternatives": { "properties": { "status": { "const": "withheld" } } } } },
      "then": { "properties": { "generated_alternatives": { "required": ["reason"], "properties": { "items": { "maxItems": 0 } } } } }
    }
  ],
  "$defs": {
    "classification": { "enum": ["observed", "agent-stated", "post-hoc-inferred"] },
    "level": { "enum": ["low", "medium", "high", "unknown"] },
    "version_proof": {
      "enum": ["immutable_copy", "pre_decision_hash", "pre_decision_time"],
      "description": "How the artifact's version at decision time was established: a copy taken before the decision and never changed, a content hash recorded before the decision that still matches, or a write time before the decision with no later write."
    },
    "generated_alternatives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "boundary", "generator", "items"],
      "description": "Phase 2: alternatives proposed after the run by a generator, from pre-decision evidence only. Kept apart from alternatives, which reports only what the run's own artifacts say.",
      "properties": {
        "status": {
          "enum": ["generated", "withheld"],
          "description": "generated: the generator ran on verified pre-decision evidence; zero items is a valid result. withheld: nothing was generated, and reason says why."
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "source"],
          "description": "The decision time used as the evidence cutoff.",
          "properties": {
            "value": { "type": ["string", "null"], "format": "date-time" },
            "source": { "enum": ["artifact_field", "artifact_header", "file_mtime", "commit_time", "unknown"] }
          }
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "generated_at"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "command": { "type": "string", "description": "Label of the configured command; never a secret or a host path." },
            "generated_at": { "type": "string", "format": "date-time" }
          }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/generated_alternative" } }
      }
    },
    "generated_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "assumptions", "potential_consequences", "uncertainty", "classification", "executed"],
      "properties": {
        "option_id": { "type": "string" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "contains": { "type": "object", "required": ["basis"], "properties": { "basis": { "const": "grounded" } } },
          "description": "At least one assumption is grounded in pre-decision evidence.",
          "items": { "$ref": "#/$defs/assumption" }
        },
        "potential_consequences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "description": "Always hypothesized, never observed outcomes."
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": {
            "level": { "enum": ["low", "medium", "high", "unknown"] },
            "note": { "type": "string", "maxLength": 300 }
          }
        },
        "classification": { "const": "generated" },
        "executed": { "const": "no" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "basis", "evidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "basis": {
          "enum": ["grounded", "unsupported"],
          "description": "grounded: backed by pre-decision evidence. unsupported: stated without evidence and shown as such."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "pointer", "sha256", "version_proof"],
            "properties": {
              "root": { "enum": ["run", "adapter", "repository"] },
              "pointer": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash of the version that existed at decision time." },
              "version_proof": { "$ref": "#/$defs/version_proof" },
              "excerpt": { "type": "string", "maxLength": 300 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "basis": { "const": "grounded" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } },
          "else": { "properties": { "evidence": { "maxItems": 0 } } }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "classification"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "classification": { "$ref": "#/$defs/classification" }
      }
    }
  }
}
